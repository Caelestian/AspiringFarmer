    <PackageReference Include="FSharp.Aspire.Hosting.AppHost" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Dsl.fs" />
    <Compile Include="Mermaid.fs" />
  </ItemGroup>
</Project>
