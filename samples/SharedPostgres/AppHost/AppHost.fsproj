<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.4" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>AspiringFarmer-Samples-SharedPostgres</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <ProjectReference Include="../../../src/AspiringFarmer.PostgreSQL/AspiringFarmer.PostgreSQL.fsproj" IsAspireProjectResource="false" />
    <ProjectReference Include="../Storefront/Storefront.fsproj" ReferenceOutputAssembly="false" IsAspireProjectResource="false" AspiringFarmerName="Storefront" />
    <ProjectReference Include="../Identity.Schema/Identity.Schema.fsproj" ReferenceOutputAssembly="false" IsAspireProjectResource="false" AspiringFarmerName="IdentitySchema" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="Verification.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <Import Project="ProjectReferences.targets" />
</Project>
