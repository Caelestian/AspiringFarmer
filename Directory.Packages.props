<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageVersion Include="Npgsql" Version="8.0.3" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="FSharp.Core" Version="10.1.400" />
    <PackageVersion Include="Aspire.Hosting" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.4" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="FSharp.Aspire.Hosting.AppHost" Version="13.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
